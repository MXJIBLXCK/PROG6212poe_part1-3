@{
    ViewData["Title"] = "My Enrolments";
    var enrolmentsJson = ViewBag.EnrolmentsJson as string;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <h2 class="mb-0">My Event Enrolments</h2>
        <div>
            <a href="/Participant/Events" class="btn btn-outline-dark me-1">Browse Events</a>
            <a href="/Participant/MyResults" class="btn btn-outline-dark">My Results</a>
        </div>
    </div>
    <hr />

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Event</th>
                            <th>Category</th>
                            <th>Date</th>
                            <th>Location</th>
                            <th>Fee</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody id="enrolmentsTableBody"></tbody>
                </table>
            </div>
            <p id="noEnrolments" class="text-muted d-none mb-0">You haven't enrolled in any events yet.</p>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const enrolments = @Html.Raw(string.IsNullOrWhiteSpace(enrolmentsJson) ? "[]" : enrolmentsJson);

        const esc = s => String(s ?? '').replace(/[&<>"']/g, c =>
            ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

        const badge = s => s === 'Completed' ? 'bg-success' : s === 'Awaiting Results' ? 'bg-warning text-dark' : 'bg-primary';

        const tbody = document.getElementById('enrolmentsTableBody');
        if (!enrolments.length) document.getElementById('noEnrolments').classList.remove('d-none');

        enrolments.forEach(en => {
            const parsed = en.eventDate ? new Date(en.eventDate) : null;
            const dateStr = parsed && !isNaN(parsed) ? parsed.toLocaleString() : 'N/A';

            const tr = document.createElement('tr');
            tr.innerHTML = `
                <td class="fw-bold">${esc(en.eventName)}</td>
                <td>${esc(en.categoryName)} (${esc(en.distanceKm)} km)</td>
                <td>${esc(dateStr)}</td>
                <td>${esc(en.location)}</td>
                <td>R${esc(en.entryFee)}</td>
                <td><span class="badge ${badge(en.status)}">${esc(en.status)}</span></td>`;
            tbody.appendChild(tr);
        });
    </script>
}
