@{
    ViewData["Title"] = "Manage Categories";
    var eventsJson = ViewBag.EventsJson as string;
    var categoriesJson = ViewBag.CategoriesJson as string;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>🏷️ Event Categories</h2>
        <a asp-action="CreateEvent" class="btn btn-success">➕ Create New Event</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <div class="row">
        <div class="col-md-5 mb-4">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">➕ Add New Category</h5>
                </div>
                <div class="card-body">
                    <form asp-action="AddCategory" method="post">
                        <div class="mb-3">
                            <label for="eventSelectCat" class="form-label fw-bold">Select Event</label>
                            <select id="eventSelectCat" name="eventId" class="form-select" required>
                                <option value="">-- Choose Event --</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Category Name</label>
                            <input type="text" name="categoryName" class="form-control" placeholder="e.g. 10km" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Distance (KM)</label>
                            <input type="number" step="0.1" min="0.1" name="distanceKm" class="form-control" placeholder="10.0" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Entry Fee (ZAR)</label>
                            <input type="number" step="0.01" min="0" name="entryFee" class="form-control" placeholder="150.00" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Max Participants</label>
                            <input type="number" min="1" name="maxParticipants" class="form-control" placeholder="200" required />
                        </div>
                        <button type="submit" class="btn btn-success w-100">Create Category</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-7">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">📋 Existing Categories</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Event</th>
                                    <th>Category</th>
                                    <th>Distance</th>
                                    <th>Fee</th>
                                    <th>Max</th>
                                </tr>
                            </thead>
                            <tbody id="categoriesTableBody"></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const events = @Html.Raw(string.IsNullOrWhiteSpace(eventsJson) ? "[]" : eventsJson);
        const categories = @Html.Raw(string.IsNullOrWhiteSpace(categoriesJson) ? "[]" : categoriesJson);

        const esc = s => String(s ?? '').replace(/[&<>"']/g, c =>
            ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

        const eventNames = {};
        const select = document.getElementById('eventSelectCat');

        events.forEach(ev => {
            const id = ev.eventId ?? ev.EventId;
            const name = ev.eventName ?? ev.EventName ?? 'Untitled Event';
            eventNames[id] = name;

            const opt = document.createElement('option');
            opt.value = id;
            opt.textContent = name;
            select.appendChild(opt);
        });

        const tbody = document.getElementById('categoriesTableBody');
        // only categories that belong to this organiser's events
        const mine = categories.filter(c => (c.eventId ?? c.EventId) in eventNames);

        if (!mine.length) {
            tbody.innerHTML = '<tr><td colspan="5" class="text-muted text-center">No categories yet.</td></tr>';
        } else {
            mine.forEach(cat => {
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td>${esc(eventNames[cat.eventId ?? cat.EventId])}</td>
                    <td><strong>${esc(cat.categoryName ?? cat.CategoryName)}</strong></td>
                    <td>${esc(cat.distanceKm ?? cat.DistanceKm)} km</td>
                    <td>R${esc(cat.entryFee ?? cat.EntryFee)}</td>
                    <td>${esc(cat.maxParticipants ?? cat.MaxParticipants)}</td>`;
                tbody.appendChild(tr);
            });
        }
    </script>
}