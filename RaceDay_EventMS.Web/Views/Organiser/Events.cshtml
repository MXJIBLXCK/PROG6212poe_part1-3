@{
    ViewData["Title"] = "Manage Events";
    var eventsJson = ViewBag.EventsJson as string;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Manage Race Events</h2>
        <a asp-action="CreateEvent" class="btn btn-success">➕ Create New Event</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            @if (string.IsNullOrEmpty(eventsJson) || eventsJson == "[]")
            {
                <p class="text-muted">No events found. Click "Create New Event" to add one.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>Banner</th>
                                <th>Title</th>
                                <th>Description</th>
                                <th>Date</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="eventsTableBody">
                            <!-- Populated dynamically via script or parsed server-side -->
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const rawJson = '@Html.Raw(eventsJson ?? "[]")';
        if (rawJson && rawJson !== "[]") {
            try {
                const events = JSON.parse(rawJson);
                const tbody = document.getElementById('eventsTableBody');
                events.forEach(ev => {
                    const tr = document.createElement('tr');
                    // Handle potential property name capitalization differences (Date vs date, BannerUrl vs bannerUrl)
                    const banner = ev.bannerUrl || ev.BannerUrl;
                    const bannerImg = banner ? `<img src="${banner}" width="80" height="50" class="object-fit-cover rounded" />` : '<span class="text-muted">No Image</span>';

                    const rawDate = ev.date || ev.Date;
                    const dateStr = rawDate ? new Date(rawDate).toLocaleDateString() : 'N/A';

                    const title = ev.title || ev.Title || 'Untitled';
                    const desc = ev.description || ev.Description || '';

                    tr.innerHTML = `
                        <td>${bannerImg}</td>
                        <td class="fw-bold">${title}</td>
                        <td>${desc}</td>
                        <td>${dateStr}</td>
                        <td>
                            <span class="badge bg-primary">Active</span>
                        </td>
                    `;
                    tbody.appendChild(tr);
                });
            } catch (err) {
                console.error("Error parsing events JSON:", err);
            }
        }
    </script>
}
