@{
    ViewData["Title"] = "Manage Events";
    var eventsJson = ViewBag.EventsJson as string;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>🎪 Manage Events</h2>
        <div>
            <a asp-action="Categories" class="btn btn-outline-primary me-2">🏷️ Categories</a>
            <a asp-action="CreateEvent" class="btn btn-success">➕ Create New Event</a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Banner</th>
                            <th>Event</th>
                            <th>Date</th>
                            <th>Location</th>
                            <th>Type</th>
                            <th>Categories</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="eventsTableBody"></tbody>
                </table>
            </div>
            <p id="noEvents" class="text-muted d-none mb-0">You haven't created any events yet.</p>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const events = @Html.Raw(string.IsNullOrWhiteSpace(eventsJson) ? "[]" : eventsJson);

        const esc = s => String(s ?? '').replace(/[&<>"']/g, c =>
            ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

        const tbody = document.getElementById('eventsTableBody');
        if (!events.length) document.getElementById('noEvents').classList.remove('d-none');

        events.forEach(ev => {
            const id = ev.eventId ?? ev.EventId;
            const name = ev.eventName ?? ev.EventName ?? 'Untitled';
            const rawDate = ev.eventDate ?? ev.EventDate;
            const banner = ev.bannerUrl ?? ev.BannerUrl;
            const cats = (ev.categories ?? ev.Categories ?? []).length;

            const parsed = rawDate ? new Date(rawDate) : null;
            const dateStr = parsed && !isNaN(parsed) ? parsed.toLocaleString() : 'N/A';

            const img = banner
                ? `<img src="${esc(banner)}" style="width:80px;height:50px;object-fit:cover;" class="rounded" />`
                : '<span class="text-muted small">none</span>';

            const tr = document.createElement('tr');
            tr.innerHTML = `
                <td>${img}</td>
                <td><strong>${esc(name)}</strong></td>
                <td>${esc(dateStr)}</td>
                <td>${esc(ev.location ?? ev.Location)}</td>
                <td><span class="badge bg-secondary">${esc(ev.eventType ?? ev.EventType)}</span></td>
                <td>${cats}</td>
                <td class="text-nowrap">
                    <a href="/Organiser/EditEvent/${esc(id)}" class="btn btn-sm btn-warning">Edit</a>
                    <form method="post" action="/Organiser/DeleteEvent/${esc(id)}" class="d-inline"
                          onsubmit="return confirm('Delete this event and its categories?')">
                        <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                    </form>
                </td>`;
            tbody.appendChild(tr);
        });
    </script>
}
