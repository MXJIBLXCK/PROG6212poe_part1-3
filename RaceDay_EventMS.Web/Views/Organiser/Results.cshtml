@{
    ViewData["Title"] = "Race Results";
}

<div class="container mt-4">
    <h2 class="mb-4">📊 Race Results Entry & Leaderboard</h2>

    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">🏃 Select Event for Results</h5>
                </div>
                <div class="card-body">
                    <form id="selectEventForm">
                        <div class="mb-3">
                            <label for="eventSelect" class="form-label fw-bold">Choose an Event</label>
                            <select id="eventSelect" class="form-control form-control-lg" required>
                                <option value="">-- Select Event --</option>
                            </select>
                        </div>
                        <button type="button" class="btn btn-primary w-100" onclick="loadEventCategories()">
                            📂 Load Categories
                        </button>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">✏️ Enter Participant Result</h5>
                </div>
                <div class="card-body">
                    <form id="resultForm">
                        <div class="mb-3">
                            <label for="categorySelect" class="form-label fw-bold">Category</label>
                            <select id="categorySelect" class="form-control" required>
                                <option value="">-- Select Category --</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label for="participantSelect" class="form-label fw-bold">Participant</label>
                            <select id="participantSelect" class="form-control" required>
                                <option value="">-- Select Participant --</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label for="finishTime" class="form-label fw-bold">Finish Time (HH:MM:SS)</label>
                            <input type="text" id="finishTime" name="finishTime" class="form-control" placeholder="00:45:30" required />
                        </div>
                        <div class="mb-3">
                            <label for="finishingPosition" class="form-label fw-bold">Finishing Position</label>
                            <input type="number" id="finishingPosition" name="finishingPosition" class="form-control" min="1" required />
                        </div>
                        <button type="submit" class="btn btn-success w-100">✅ Submit Result</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">🏆 Results Leaderboard</h5>
                </div>
                <div class="card-body">
                    <div id="leaderboardMessage" class="alert alert-info text-center">
                        <strong>👉 Select an event above to view the leaderboard</strong>
                    </div>
                    <div class="table-responsive" id="leaderboardContainer" style="display:none;">
                        <table class="table table-striped table-hover align-middle">
                            <thead class="table-dark">
                                <tr>
                                    <th>🥇 Position</th>
                                    <th>👤 Participant Name</th>
                                    <th>⏱️ Finish Time</th>
                                    <th>📏 Category</th>
                                    <th>⚙️ Actions</th>
                                </tr>
                            </thead>
                            <tbody id="resultsTableBody">
                                <!-- Populated dynamically -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let allEvents = [];
        let allCategories = [];
        let allEnrolments = [];

        // Load events on page load
        document.addEventListener('DOMContentLoaded', function () {
            loadEvents();
            setupResultFormSubmission();
        });

        function loadEvents() {
            const rawJson = '@Html.Raw(ViewBag.EventsJson ?? "[]")';
            if (rawJson && rawJson !== "[]") {
                try {
                    allEvents = JSON.parse(rawJson);
                    const select = document.getElementById('eventSelect');
                    
                    allEvents.forEach(ev => {
                        const option = document.createElement('option');
                        option.value = ev.eventId || ev.EventId;
                        option.textContent = ev.title || ev.Title || 'Untitled';
                        select.appendChild(option);
                    });
                } catch (err) {
                    console.error("Error loading events:", err);
                }
            }
        }

        async function loadEventCategories() {
            const eventId = document.getElementById('eventSelect').value;
            if (!eventId) {
                alert('❌ Please select an event');
                return;
            }

            try {
                // Fetch categories for this event
                const response = await fetch(`/api/categories?eventId=${eventId}`);
                if (response.ok) {
                    allCategories = await response.json();
                    
                    // Populate category dropdown
                    const categorySelect = document.getElementById('categorySelect');
                    categorySelect.innerHTML = '<option value="">-- Select Category --</option>';
                    
                    allCategories.forEach(cat => {
                        const option = document.createElement('option');
                        option.value = cat.categoryId || cat.CategoryId;
                        option.textContent = cat.categoryName || cat.CategoryName || 'Untitled';
                        categorySelect.appendChild(option);
                    });

                    // Fetch enrolments for this event
                    const enrolmentsResponse = await fetch(`/api/enrolments?eventId=${eventId}`);
                    if (enrolmentsResponse.ok) {
                        allEnrolments = await enrolmentsResponse.json();
                        loadLeaderboard(eventId);
                    }
                } else {
                    alert('❌ Failed to load categories');
                }
            } catch (err) {
                console.error('Error loading categories:', err);
                alert('❌ Error loading categories');
            }
        }

        async function loadLeaderboard(eventId) {
            try {
                const response = await fetch(`/api/results?eventId=${eventId}`);
                if (response.ok) {
                    const results = await response.json();
                    displayLeaderboard(results);
                }
            } catch (err) {
                console.error('Error loading leaderboard:', err);
            }
        }

        function displayLeaderboard(results) {
            const container = document.getElementById('leaderboardContainer');
            const message = document.getElementById('leaderboardMessage');
            const tbody = document.getElementById('resultsTableBody');

            if (!results || results.length === 0) {
                message.textContent = '📊 No results recorded yet for this event';
                container.style.display = 'none';
                return;
            }

            message.style.display = 'none';
            container.style.display = 'block';
            tbody.innerHTML = '';

            results.sort((a, b) => {
                const posA = a.finishingPosition || a.FinishingPosition || 999;
                const posB = b.finishingPosition || b.FinishingPosition || 999;
                return posA - posB;
            });

            results.forEach((result, index) => {
                const tr = document.createElement('tr');
                const position = result.finishingPosition || result.FinishingPosition || (index + 1);
                const participantName = result.participantName || result.ParticipantName || 'Unknown';
                const finishTime = result.finishTimeSeconds || result.FinishTimeSeconds || 0;
                const categoryName = result.categoryName || result.CategoryName || 'Unknown';
                const resultId = result.enrolmentId || result.EnrolmentId;

                // Format time
                const hours = Math.floor(finishTime / 3600);
                const minutes = Math.floor((finishTime % 3600) / 60);
                const seconds = finishTime % 60;
                const timeFormatted = `${hours.toString().padStart(2, '0')}:${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;

                // Medal emoji
                let medal = '';
                if (position === 1) medal = '🥇';
                else if (position === 2) medal = '🥈';
                else if (position === 3) medal = '🥉';

                tr.innerHTML = `
                    <td><strong>${medal} ${position}</strong></td>
                    <td>${participantName}</td>
                    <td><code>${timeFormatted}</code></td>
                    <td><span class="badge bg-info">${categoryName}</span></td>
                    <td>
                        <button class="btn btn-sm btn-warning" onclick="editResult(${resultId})">Edit</button>
                        <button class="btn btn-sm btn-danger" onclick="deleteResult(${resultId})">Delete</button>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        function setupResultFormSubmission() {
            document.getElementById('resultForm').addEventListener('submit', async function (e) {
                e.preventDefault();

                const categoryId = document.getElementById('categorySelect').value;
                const participantId = document.getElementById('participantSelect').value;
                const finishTimeStr = document.getElementById('finishTime').value;
                const finishingPosition = document.getElementById('finishingPosition').value;

                // Convert time string to seconds
                const timeParts = finishTimeStr.split(':');
                let finishTimeSeconds = 0;
                if (timeParts.length === 3) {
                    finishTimeSeconds = parseInt(timeParts[0]) * 3600 + parseInt(timeParts[1]) * 60 + parseInt(timeParts[2]);
                } else {
                    alert('❌ Invalid time format. Use HH:MM:SS');
                    return;
                }

                try {
                    const response = await fetch('/Organiser/SubmitResult', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            categoryId: parseInt(categoryId),
                            participantId: parseInt(participantId),
                            finishTimeSeconds: finishTimeSeconds,
                            finishingPosition: parseInt(finishingPosition)
                        })
                    });

                    if (response.ok) {
                        alert('✅ Result submitted successfully!');
                        document.getElementById('resultForm').reset();
                        loadEventCategories(); // Refresh leaderboard
                    } else {
                        alert('❌ Failed to submit result');
                    }
                } catch (err) {
                    console.error('Error submitting result:', err);
                    alert('❌ Error submitting result');
                }
            });
        }

        function editResult(resultId) {
            alert('Edit functionality to be implemented for result ' + resultId);
        }

        function deleteResult(resultId) {
            if (confirm('Are you sure you want to delete this result?')) {
                alert('Delete functionality to be implemented for result ' + resultId);
            }
        }
    </script>
}
