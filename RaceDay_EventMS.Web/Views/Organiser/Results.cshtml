@{
    ViewData["Title"] = "Race Results";
    var eventsJson = ViewBag.EventsJson as string ?? "[]";
    var enrolmentsJson = ViewBag.EnrolmentsJson as string ?? "[]";
}

<div class="container mt-4">
    <h2 class="mb-4">📊 Race Results Entry & Leaderboard</h2>

    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">🏃 Select Event for Results</h5>
                </div>
                <div class="card-body">
                    <form id="selectEventForm">
                        <div class="mb-3">
                            <label for="eventSelect" class="form-label fw-bold">Choose an Event</label>
                            <select id="eventSelect" class="form-select form-select-lg" required>
                                <option value="">-- Select Event --</option>
                            </select>
                        </div>
                        <button type="button" class="btn btn-primary w-100" onclick="filterDataByEvent()">
                            📂 Load Categories & Participants
                        </button>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">✏️ Enter Participant Result</h5>
                </div>
                <div class="card-body">
                    <form asp-action="SubmitResult" method="post" id="resultForm">
                        <div class="mb-3">
                            <label for="enrolmentSelect" class="form-label fw-bold">Participant / Enrolment</label>
                            <select id="enrolmentSelect" name="enrolmentId" class="form-select" required>
                                <option value="">-- Select Event First --</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label for="finishTime" class="form-label fw-bold">Finish Time (HH:MM:SS)</label>
                            <input type="text" id="finishTime" name="finishTimeStr" class="form-control" placeholder="00:45:30" required />
                        </div>
                        <div class="mb-3">
                            <label for="finishingPosition" class="form-label fw-bold">Finishing Position</label>
                            <input type="number" id="finishingPosition" name="finishingPosition" class="form-control" min="1" required />
                        </div>
                        <button type="submit" class="btn btn-success w-100">✅ Submit Result</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">🏆 Results Leaderboard</h5>
                </div>
                <div class="card-body">
                    <div id="leaderboardMessage" class="alert alert-info text-center">
                        <strong>👉 Select an event above to view the leaderboard</strong>
                    </div>
                    <div class="table-responsive" id="leaderboardContainer" style="display:none;">
                        <table class="table table-striped table-hover align-middle">
                            <thead class="table-dark">
                                <tr>
                                    <th>🥇 Position</th>
                                    <th>👤 Participant Name</th>
                                    <th>⏱️ Finish Time</th>
                                    <th>📏 Category</th>
                                </tr>
                            </thead>
                            <tbody id="resultsTableBody">
                                <!-- Populated dynamically -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const rawEvents = '@Html.Raw(eventsJson)';
        const rawEnrolments = '@Html.Raw(enrolmentsJson)';

        let allEvents = [];
        let allEnrolments = [];

        document.addEventListener('DOMContentLoaded', function () {
            try {
                allEvents = JSON.parse(rawEvents);
                allEnrolments = JSON.parse(rawEnrolments);
            } catch (e) {
                console.error("Error parsing server data", e);
            }
            populateEventDropdown();
        });

        function populateEventDropdown() {
            const select = document.getElementById('eventSelect');
            select.innerHTML = '<option value="">-- Select Event --</option>';

            allEvents.forEach(ev => {
                const id = ev.eventId || ev.EventId || ev.id;
                const name = ev.eventName || ev.EventName || ev.title || ev.Title || 'Untitled Event';
                const option = document.createElement('option');
                option.value = id;
                option.textContent = name;
                select.appendChild(option);
            });
        }

        function filterDataByEvent() {
            const eventId = document.getElementById('eventSelect').value;
            if (!eventId) {
                alert('Please select an event');
                return;
            }

            const enrolmentSelect = document.getElementById('enrolmentSelect');
            enrolmentSelect.innerHTML = '<option value="">-- Select Participant --</option>';

            // Filter enrolments for selected event
            const filteredEnrolments = allEnrolments.filter(e => {
                const eId = e.eventId || e.EventId;
                return eId == eventId;
            });

            if (filteredEnrolments.length === 0) {
                enrolmentSelect.innerHTML = '<option value="">No participants registered for this event</option>';
            } else {
                filteredEnrolments.forEach(en => {
                    const enId = en.enrolmentId || en.EnrolmentId || en.id;
                    const name = en.participantName || en.UserFullName || en.UserName || `Participant #${enId}`;
                    const opt = document.createElement('option');
                    opt.value = enId;
                    opt.textContent = name;
                    enrolmentSelect.appendChild(opt);
                });
            }

            // Render leaderboard container
            const container = document.getElementById('leaderboardContainer');
            const message = document.getElementById('leaderboardMessage');
            message.style.display = 'none';
            container.style.display = 'block';
        }
    </script>
}
