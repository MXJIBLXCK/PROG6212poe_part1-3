@{
    ViewData["Title"] = "Organiser Dashboard";
    var eventsJson = ViewBag.EventsJson as string ?? "[]";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12 d-flex justify-content-between align-items-center">
            <h2>📊 Organiser Dashboard</h2>
            <a asp-action="CreateEvent" class="btn btn-success">➕ Create New Event</a>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">📅 Your Managed Events</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>Event Name</th>
                                    <th>Date</th>
                                    <th>Location</th>
                                    <th>Type</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody id="eventsTableBody">
                                <!-- Populated by script -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const rawJson = '@Html.Raw(eventsJson)';
        document.addEventListener('DOMContentLoaded', function () {
            if (rawJson && rawJson !== "[]") {
                try {
                    const events = JSON.parse(rawJson);
                    const tbody = document.getElementById('eventsTableBody');
                    if (tbody) {
                        tbody.innerHTML = '';
                        events.forEach(ev => {
                            const tr = document.createElement('tr');
                            const title = ev.eventName || ev.EventName || ev.title || ev.Title || 'Untitled';
                            const date = ev.eventDate || ev.EventDate || ev.date || ev.Date;
                            const location = ev.location || ev.Location || 'N/A';
                            const eventType = ev.eventType || ev.EventType || 'N/A';
                            const eventId = ev.eventId || ev.EventId || ev.id;

                            let dateStr = 'N/A';
                            if (date) {
                                const parsedDate = new Date(date);
                                if (!isNaN(parsedDate)) {
                                    dateStr = parsedDate.toLocaleDateString();
                                }
                            }

                            tr.innerHTML = `
                                <td><strong>${title}</strong></td>
                                <td>${dateStr}</td>
                                <td>${location}</td>
                                <td><span class="badge bg-secondary">${eventType}</span></td>
                                <td>
                                    <a href="/Organiser/EditEvent/${eventId}" class="btn btn-sm btn-warning">Edit</a>
                                    <a href="/Organiser/DeleteEvent/${eventId}" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure?')">Delete</a>
                                </td>
                            `;
                            tbody.appendChild(tr);
                        });
                    }
                } catch (err) {
                    console.error("Error parsing events JSON:", err);
                }
            }
        });
    </script>
}
