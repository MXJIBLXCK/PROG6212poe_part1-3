@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="mb-4">📊 Organiser Dashboard</h2>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card bg-primary text-white shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Total Events</h5>
                    <h2>@(ViewBag.EventCount ?? 0)</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-success text-white shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Upcoming Events</h5>
                    <h2>@(ViewBag.UpcomingEvents ?? 0)</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-info text-white shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Total Enrolments</h5>
                    <h2>@(ViewBag.TotalEnrolments ?? 0)</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-warning text-white shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Active Categories</h5>
                    <h2>0</h2>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">📅 Upcoming Events Summary</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>Event Name</th>
                                    <th>Date</th>
                                    <th>Location</th>
                                    <th>Type</th>
                                    <th>Enrolments</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody id="eventsTableBody">
                                <!-- Populated by script -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const rawJson = '@Html.Raw(ViewBag.EventsJson ?? "[]")';
        if (rawJson && rawJson !== "[]") {
            try {
                const events = JSON.parse(rawJson);
                const tbody = document.getElementById('eventsTableBody');
                tbody.innerHTML = '';

                events.forEach(ev => {
                    const tr = document.createElement('tr');
                    const title = ev.title || ev.Title || 'Untitled';
                    const date = ev.eventDate || ev.EventDate || 'N/A';
                    const location = ev.location || ev.Location || 'N/A';
                    const eventType = ev.eventType || ev.EventType || 'N/A';
                    const eventId = ev.eventId || ev.EventId;

                    let dateStr = 'N/A';
                    if (date) {
                        const parsedDate = new Date(date);
                        if (!isNaN(parsedDate)) {
                            dateStr = parsedDate.toLocaleDateString();
                        }
                    }

                    tr.innerHTML = `
                        <td><strong>${title}</strong></td>
                        <td>${dateStr}</td>
                        <td>${location}</td>
                        <td><span class="badge bg-secondary">${eventType}</span></td>
                        <td>0</td>
                        <td>
                            <a href="/Organiser/EditEvent/${eventId}" class="btn btn-sm btn-warning">Edit</a>
                            <a href="/Organiser/DeleteEvent/${eventId}" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure?')">Delete</a>
                        </td>
                    `;
                    tbody.appendChild(tr);
                });
            } catch (err) {
                console.error("Error parsing events JSON:", err);
            }
        }
    </script>
}
