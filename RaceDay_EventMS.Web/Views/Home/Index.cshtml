@{
    ViewData["Title"] = "Home Page";
    var userRole = Context.Session.GetString("UserRole");
    var userEmail = Context.Session.GetString("UserEmail");
}

<div class="container mt-4">
    <!-- Hero Banner -->
    <div class="p-5 mb-4 bg-dark text-white rounded-3 shadow">
        <div class="container-fluid py-4">
            <h1 class="display-5 fw-bold text-warning">🏁 Welcome to RaceDay Event Management</h1>
            <p class="col-md-8 fs-4 mt-3">
                Your premier platform for organising running events, managing participant enrolments, tracking Azure-backed event banners, and viewing live race leaderboards.
            </p>

            @if (string.IsNullOrEmpty(userEmail))
            {
                <div class="mt-4">
                    <a class="btn btn-primary btn-lg me-2" asp-controller="Account" asp-action="Login">Login</a>
                    <a class="btn btn-outline-light btn-lg" asp-controller="Account" asp-action="Register">Register Now</a>
                </div>
            }
            else
            {
                <div class="mt-3">
                    <span class="text-info fs-5">Logged in as: <strong>@userEmail</strong> (@userRole)</span>
                </div>
            }
        </div>
    </div>

    <!-- Quick Stats / Feature Cards -->
    <div class="row align-md-items-stretch g-4 py-2">
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body d-flex flex-column">
                    <h3 class="card-title text-primary">🏃 Event Discovery</h3>
                    <p class="card-text text-muted flex-grow-1">
                        Browse upcoming endurance races, marathons, and cycling events. Enrol with a single click and keep track of all your registrations.
                    </p>
                    @if (userRole == "Participant")
                    {
                        <a asp-controller="Participant" asp-action="Events" class="btn btn-outline-primary mt-auto">Browse Events</a>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary mt-auto">Get Started</a>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body d-flex flex-column">
                    <h3 class="card-title text-success">📋 Organiser Portal</h3>
                    <p class="card-text text-muted flex-grow-1">
                        Create and configure events, upload promotional banner images directly to Azure Blob Storage, and manage participant lists seamlessly.
                    </p>
                    @if (userRole == "Organiser")
                    {
                        <a asp-controller="Organiser" asp-action="Events" class="btn btn-outline-success mt-auto">Manage Events</a>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-success mt-auto">Organiser Login</a>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body d-flex flex-column">
                    <h3 class="card-title text-warning">🏆 Results & Leaderboards</h3>
                    <p class="card-text text-muted flex-grow-1">
                        Log finish times, check rankings instantly, and view comprehensive leaderboards for every completed race event.
                    </p>
                    <a asp-controller="Results" asp-action="Leaderboard" asp-route-eventId="1" class="btn btn-outline-dark mt-auto">View Leaderboard</a>
                </div>
            </div>
        </div>
    </div>
</div>
